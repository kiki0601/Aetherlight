<Application x:Class="Aetherlight.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#101112"/>
    <SolidColorBrush x:Key="Panel" Color="#17191B"/>
    <SolidColorBrush x:Key="Panel2" Color="#202326"/>
    <SolidColorBrush x:Key="Panel3" Color="#272A2D"/>
    <SolidColorBrush x:Key="Border" Color="#34383C"/>
    <SolidColorBrush x:Key="Text" Color="#E9EAEC"/>
    <SolidColorBrush x:Key="Muted" Color="#92979D"/>
    <SolidColorBrush x:Key="Accent" Color="#D6A34A"/>
    <SolidColorBrush x:Key="Hover" Color="#2C3034"/>
    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="{StaticResource Panel2}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="Button" x:Key="CompactButton" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="9,5"/>
      <Setter Property="MinHeight" Value="28"/>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Height" Value="18"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="Background" Value="#3B3F43"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="9"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style TargetType="Separator">
      <Setter Property="Background" Value="#363A3E"/>
      <Setter Property="Margin" Value="0,12"/>
    </Style>
    <Style TargetType="StatusBar">
      <Setter Property="FontSize" Value="11"/>
    </Style>
  </Application.Resources>
</Application>