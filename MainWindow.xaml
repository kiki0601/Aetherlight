<Window x:Class="Aetherlight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aetherlight" Width="1500" Height="900" MinWidth="1100" MinHeight="700"
        Background="#171717" UseLayoutRounding="True" SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="LowQuality">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E5E5E5"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
        <Style TargetType="Button"><Setter Property="Foreground" Value="#E7E7E7"/><Setter Property="Background" Value="#242424"/><Setter Property="BorderBrush" Value="#383838"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="2"/><Setter Property="FontSize" Value="12"/></Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#202020"/><Setter Property="BorderBrush" Value="#303030"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="10,8"/></Style>
        <Style x:Key="ValueBox" TargetType="TextBox"><Setter Property="Foreground" Value="#DADADA"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="2,0"/><Setter Property="FontSize" Value="11"/><Setter Property="Width" Value="62"/><Setter Property="HorizontalContentAlignment" Value="Right"/><Setter Property="ToolTip" Value="Click and type an exact value. Press Enter to apply."/></Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock"><Setter Property="Foreground" Value="#9D9D9D"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#202020" BorderBrush="#303030" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0"><TextBlock Text="AETHERLIGHT" FontSize="15" FontWeight="Bold" Foreground="#F1F1F1" VerticalAlignment="Center"/><TextBlock Text="  RAW EDITOR" FontSize="10" Foreground="#777" VerticalAlignment="Center" Margin="6,2,0,0"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button x:Name="LibraryTab" Content="LIBRARY" Style="{StaticResource NavButton}" Click="Library_Click"/><Button x:Name="DevelopTab" Content="DEVELOP" Style="{StaticResource NavButton}" Click="Develop_Click"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"><Button Content="Import" Click="Import_Click"/><Button Content="Export" Click="Export_Click"/></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid x:Name="LibraryView">
                <Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#1D1D1D" BorderBrush="#303030" BorderThickness="0,0,1,0"><StackPanel Margin="14"><TextBlock Text="LIBRARY" Style="{StaticResource SectionHeader}" Margin="4,4,4,14"/><TextBlock Text="CATALOG" Foreground="#777" FontSize="10" Margin="4,0,4,8"/><TreeView Background="Transparent" BorderThickness="0"><TreeViewItem Header="All Photos" IsExpanded="True"><TreeViewItem Header="Recently Added"/><TreeViewItem Header="Favorites"/><TreeViewItem Header="Rejected"/></TreeViewItem><TreeViewItem Header="Folders" IsExpanded="True"><TreeViewItem Header="RAW Library"/></TreeViewItem><TreeViewItem Header="Collections" IsExpanded="True"><TreeViewItem Header="Portfolio"/><TreeViewItem Header="Print Selects"/></TreeViewItem></TreeView></StackPanel></Border>
                <Grid Grid.Column="1" Background="#151515"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="145"/></Grid.RowDefinitions><Border Margin="18" Background="#0D0D0D" BorderBrush="#292929" BorderThickness="1"><Grid><TextBlock x:Name="EmptyHint" Text="Import photos to begin&#x0A;&#x0A;CR3  •  ARW  •  RAF  •  DNG  •  TIFF  •  JPEG" TextAlignment="Center" VerticalAlignment="Center" Foreground="#666" FontSize="15"/><Image x:Name="Preview" Stretch="Uniform" Visibility="Collapsed"/></Grid></Border><Border Grid.Row="1" Background="#1B1B1B" BorderBrush="#303030" BorderThickness="0,1,0,0"><ScrollViewer HorizontalScrollBarVisibility="Auto"><WrapPanel x:Name="Filmstrip" Margin="12"/></ScrollViewer></Border></Grid>
                <Border Grid.Column="2" Background="#1D1D1D" Padding="18"><StackPanel><TextBlock Text="FOLDER" Foreground="#777" FontSize="10"/><TextBlock Text="All Photos" FontSize="19" Margin="0,5,0,4"/><TextBlock x:Name="LibraryCount" Text="0 photos" Foreground="#888"/><Button Content="Import Photos" Click="Import_Click" HorizontalAlignment="Left" Margin="0,22,0,0"/><Separator Margin="0,22"/><TextBlock Text="Aetherlight Catalog" FontWeight="SemiBold"/><TextBlock Text="Non-destructive RAW development and photo organization." TextWrapping="Wrap" Foreground="#888" Margin="0,8,0,0"/></StackPanel></Border>
            </Grid>
            <Grid x:Name="DevelopView" Visibility="Collapsed" Background="#151515">
                <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#1C1C1C" BorderBrush="#303030" BorderThickness="0,0,1,0"><StackPanel Margin="7,12"><Button Content="CROP" Style="{StaticResource ToolButton}" ToolTip="Crop &amp; Straighten" Click="Crop_Click"/><Button Content="HEAL" Style="{StaticResource ToolButton}" ToolTip="Heal" Click="Heal_Click"/><Button Content="MASK" Style="{StaticResource ToolButton}" ToolTip="Masking" Click="Mask_Click"/><Button Content="PICK" Style="{StaticResource ToolButton}" ToolTip="Color Picker" Click="Picker_Click"/><Separator Margin="3,12"/><Button Content="B" Style="{StaticResource ToolButton}" ToolTip="Basic"/><Button Content="C" Style="{StaticResource ToolButton}" ToolTip="Curves"/><Button Content="M" Style="{StaticResource ToolButton}" ToolTip="Color Mixer"/><Button Content="D" Style="{StaticResource ToolButton}" ToolTip="Detail"/><Button Content="E" Style="{StaticResource ToolButton}" ToolTip="Effects"/></StackPanel></Border>
                <Grid Grid.Column="1" Background="#101010"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="118"/></Grid.RowDefinitions><Border Margin="16,14,16,10" Background="#080808" BorderBrush="#292929" BorderThickness="1"><Grid><Image x:Name="DevelopPreview" Stretch="Uniform" CacheMode="BitmapCache" MouseLeftButtonDown="Preview_MouseDown" MouseMove="Preview_MouseMove" MouseLeftButtonUp="Preview_MouseUp"/><Canvas x:Name="OverlayCanvas" IsHitTestVisible="False"/><TextBlock x:Name="DevelopEmpty" Text="Select a photo in Library" Foreground="#666" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><Border Grid.Row="1" Background="#1B1B1B" BorderBrush="#303030" BorderThickness="0,1,0,0"><Grid Margin="10,8"><ScrollViewer HorizontalScrollBarVisibility="Auto"><WrapPanel x:Name="EditorFilmstrip"/></ScrollViewer><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,3"><TextBlock Text="Zoom" Foreground="#777" FontSize="10" Margin="0,0,6,0"/><TextBlock Text="100%" Foreground="#AAA" FontSize="10"/></StackPanel></Grid></Border></Grid>
                <ScrollViewer Grid.Column="2" Background="#202020" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="14,12,12,18">
                    <Grid Margin="0,0,0,8"><TextBlock Text="ADJUSTMENTS" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="↻" Foreground="#888" HorizontalAlignment="Right" FontSize="16"/></Grid>
                    <Border Height="135" Background="#151515" CornerRadius="3" Margin="0,0,0,10"><Canvas x:Name="HistogramCanvas" Margin="4,0"/></Border>
                    <Expander Header="BASIC" IsExpanded="True" Foreground="#EEE" FontWeight="SemiBold"><StackPanel Margin="4,8,4,4">
                        <Grid Margin="0,0,0,8"><TextBlock Text="Profile" Foreground="#999" VerticalAlignment="Center"/><Button x:Name="ProfileButton" Content="Camera Standard" Width="150" HorizontalAlignment="Right" Click="ProfileButton_Click"/></Grid><TextBlock x:Name="ProfileValue" Text="Camera Standard" Foreground="#777" FontSize="10" Margin="0,-3,0,8"/>
                        <Grid Margin="0,0,0,8"><TextBlock Text="Tone Mapper" Foreground="#999"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Basic" Padding="8,3"/><Button Content="AgX" Padding="8,3"/></StackPanel></Grid>
                        <Grid><TextBlock Text="Exposure"/><TextBox x:Name="ExposureValue" Text="0.00" Style="{StaticResource ValueBox}" Tag="Exposure" PreviewMouseLeftButtonDown="SliderNumber_MouseDown" KeyDown="SliderNumber_KeyDown" LostFocus="SliderNumber_LostFocus"/></Grid><Slider x:Name="ExposureSlider" Minimum="-5" Maximum="5" Value="0" Margin="0,2,0,7"/>
                        <Grid><TextBlock Text="Contrast"/><TextBox x:Name="ContrastValue" Text="0" Style="{StaticResource ValueBox}" Tag="Contrast" PreviewMouseLeftButtonDown="SliderNumber_MouseDown" KeyDown="SliderNumber_KeyDown" LostFocus="SliderNumber_LostFocus"/></Grid><Slider x:Name="ContrastSlider" Minimum="-100" Maximum="100" Value="0" Margin="0,2,0,7"/>
                        <Grid><TextBlock Text="Highlights"/><TextBox x:Name="HighlightsValue" Text="0" Style="{StaticResource ValueBox}" Tag="Highlights" PreviewMouseLeftButtonDown="SliderNumber_MouseDown" KeyDown="SliderNumber_KeyDown" LostFocus="SliderNumber_LostFocus"/></Grid><Slider x:Name="HighlightsSlider" Minimum="-100" Maximum="100" Value="0" Margin="0,2,0,7"/>
                        <Grid><TextBlock Text="Shadows"/><TextBox x:Name="ShadowsValue" Text="0" Style="{StaticResource ValueBox}" Tag="Shadows" PreviewMouseLeftButtonDown="SliderNumber_MouseDown" KeyDown="SliderNumber_KeyDown" LostFocus="SliderNumber_LostFocus"/></Grid><Slider x:Name="ShadowsSlider" Minimum="-100" Maximum="100" Value="0" Margin="0,2,0,7"/>
                        <Grid><TextBlock Text="Whites"/><TextBox x:Name="WhitesValue" Text="0" Style="{StaticResource ValueBox}" Tag="Whites" PreviewMouseLeftButtonDown="SliderNumber_MouseDown" KeyDown="SliderNumber_KeyDown" LostFocus="SliderNumber_LostFocus"/></Grid><Slider x:Name="WhitesSlider" Minimum="-100" Maximum="100" Value="0" Margin="0,2,0,7"/>
                        <Grid><TextBlock Text="Blacks"/><TextBox x:Name="BlacksValue" Text="0" Style="{StaticResource ValueBox}" Tag="Blacks" PreviewMouseLeftButtonDown="SliderNumber_MouseDown" KeyDown="SliderNumber_KeyDown" LostFocus="SliderNumber_LostFocus"/></Grid><Slider x:Name="BlacksSlider" Minimum="-100" Maximum="100" Value="0" Margin="0,2,0,4"/>
                    </StackPanel></Expander>
                    <Expander Header="CURVES" IsExpanded="True" Foreground="#EEE" FontWeight="SemiBold" Margin="0,5,0,0"><StackPanel Margin="4,8,4,4"><Grid Height="190" Background="#151515"><Canvas><Polyline Points="0,178 45,160 95,132 150,96 205,55 260,20 330,5" Stroke="#D7D7D7" StrokeThickness="2"/><Line X1="0" Y1="178" X2="330" Y2="5" Stroke="#444" StrokeDashArray="3,3"/></Canvas></Grid><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0"><Button Content="L" Padding="8,3"/><Button Content="R" Padding="8,3"/><Button Content="G" Padding="8,3"/><Button Content="B" Padding="8,3"/></StackPanel></StackPanel></Expander>
                    <Expander Header="COLOR" IsExpanded="True" Foreground="#EEE" FontWeight="SemiBold" Margin="0,5,0,0"><StackPanel Margin="4,8,4,4"><TextBlock Text="WHITE BALANCE" Foreground="#999" FontSize="10" Margin="0,0,0,7"/><Grid><TextBlock Text="Temperature"/><TextBox x:Name="TemperatureValue" Text="6500 K" Style="{StaticResource ValueBox}" Width="72" Tag="Temperature" PreviewMouseLeftButtonDown="SliderNumber_MouseDown" KeyDown="SliderNumber_KeyDown" LostFocus="SliderNumber_LostFocus"/></Grid><Slider x:Name="TemperatureSlider" Minimum="2000" Maximum="50000" Value="6500" TickFrequency="100" Margin="0,2,0,8"/><Grid><TextBlock Text="Tint"/><TextBox x:Name="TintValue" Text="0" Style="{StaticResource ValueBox}" Tag="Tint" PreviewMouseLeftButtonDown="SliderNumber_MouseDown" KeyDown="SliderNumber_KeyDown" LostFocus="SliderNumber_LostFocus"/></Grid><Slider x:Name="TintSlider" Minimum="-150" Maximum="150" Value="0" TickFrequency="1" Margin="0,2,0,10"/><TextBlock Text="PRESENCE" Foreground="#999" FontSize="10" Margin="0,0,0,7"/><Grid><TextBlock Text="Vibrance"/><TextBox x:Name="VibranceValue" Text="0" Style="{StaticResource ValueBox}" Tag="Vibrance" PreviewMouseLeftButtonDown="SliderNumber_MouseDown" KeyDown="SliderNumber_KeyDown" LostFocus="SliderNumber_LostFocus"/></Grid><Slider x:Name="VibranceSlider" Minimum="-100" Maximum="100" Value="0" Margin="0,2,0,7"/><Grid><TextBlock Text="Saturation"/><TextBox x:Name="SaturationValue" Text="0" Style="{StaticResource ValueBox}" Tag="Saturation" PreviewMouseLeftButtonDown="SliderNumber_MouseDown" KeyDown="SliderNumber_KeyDown" LostFocus="SliderNumber_LostFocus"/></Grid><Slider x:Name="SaturationSlider" Minimum="-100" Maximum="100" Value="0" Margin="0,2,0,8"/><TextBlock Text="COLOR MIXER" Foreground="#999" FontSize="10" Margin="0,4,0,7"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Ellipse Width="16" Height="16" Fill="#F16B6B" Margin="3"/><Ellipse Width="16" Height="16" Fill="#F2B64B" Margin="3"/><Ellipse Width="16" Height="16" Fill="#7BC96F" Margin="3"/><Ellipse Width="16" Height="16" Fill="#5AA7E8" Margin="3"/><Ellipse Width="16" Height="16" Fill="#8E72D8" Margin="3"/></StackPanel></StackPanel></Expander>
                    <Expander Header="DETAIL" Foreground="#EEE" FontWeight="SemiBold" Margin="0,5,0,0"><StackPanel Margin="4,8"><TextBlock Text="Sharpening"/><Slider/><TextBlock Text="Noise Reduction" Margin="0,8,0,0"/><Slider/></StackPanel></Expander>
                    <Expander Header="EFFECTS" Foreground="#EEE" FontWeight="SemiBold" Margin="0,5,0,0"><StackPanel Margin="4,8"><TextBlock Text="Texture"/><Slider/><TextBlock Text="Clarity" Margin="0,8,0,0"/><Slider/><TextBlock Text="Dehaze" Margin="0,8,0,0"/><Slider/></StackPanel></Expander>
                    <Expander Header="COLOR GRADING" Foreground="#EEE" FontWeight="SemiBold" Margin="0,5,0,0"><StackPanel Margin="4,8"><TextBlock Text="3-Way" Foreground="#999" FontSize="10"/><Grid Height="150" Margin="0,8"><Ellipse Width="110" Height="110" Stroke="#555" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse Width="8" Height="8" Fill="#DDD" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><TextBlock Text="Blending"/><Slider/><TextBlock Text="Balance" Margin="0,8,0,0"/><Slider/></StackPanel></Expander>
                    <Expander Header="MASKING" Foreground="#EEE" FontWeight="SemiBold" Margin="0,5,0,0"><StackPanel Margin="4,8"><WrapPanel><Button Content="Subject • AI"/><Button Content="Sky • AI"/><Button Content="Brush" Click="Mask_Click"/><Button Content="Linear"/><Button Content="Radial"/></WrapPanel></StackPanel></Expander>
                    <StackPanel x:Name="LegacyToolControls" Visibility="Visible" Margin="0,8,0,0"><StackPanel x:Name="CropControls" Visibility="Collapsed"><TextBlock Text="STRAIGHTEN" Foreground="#999" FontSize="10"/><Slider x:Name="CropAngleSlider" Minimum="-15" Maximum="15" Value="0" ValueChanged="CropAngle_ValueChanged"/><TextBlock x:Name="CropAngleValue" Text="0.0°"/><Button Content="Apply Crop" Click="ApplyCrop_Click"/><Button Content="Cancel" Click="CancelTool_Click"/></StackPanel><StackPanel x:Name="MaskControls" Visibility="Collapsed"><TextBlock Text="BRUSH MASK" Foreground="#999" FontSize="10"/><Slider x:Name="MaskSizeSlider" Minimum="5" Maximum="150" Value="40"/><TextBlock Text="Mask Exposure"/><Slider x:Name="MaskExposureSlider" Minimum="-3" Maximum="3" Value="1" ValueChanged="MaskExposure_ValueChanged"/><TextBlock x:Name="MaskExposureValue" Text="+1.00"/><Button Content="Apply Mask" Click="ApplyMask_Click"/><Button Content="Clear Mask" Click="ClearMask_Click"/><Button Content="Exit Masking" Click="CancelTool_Click"/></StackPanel></StackPanel>
                </StackPanel></ScrollViewer>
            </Grid>
        </Grid>
        <StatusBar Grid.Row="2" Background="#111"><TextBlock x:Name="StatusText" Text="Aetherlight • Ready" Foreground="#888"/><TextBlock Text="Windows x64" HorizontalAlignment="Right" Margin="20,0" Foreground="#555"/></StatusBar>
    </Grid>
</Window>