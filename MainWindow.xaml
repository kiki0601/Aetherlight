<Window x:Class="Aetherlight.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Aetherlight" Width="1500" Height="900" MinWidth="1100" MinHeight="700" Background="{StaticResource Bg}" Loaded="Window_Loaded" UseLayoutRounding="True" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="LowQuality">
<Grid>
<Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="#111" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"><Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><TextBlock Text="AETHERLIGHT" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="LibraryTab" Content="LIBRARY" Click="Library_Click"/><Button x:Name="DevelopTab" Content="DEVELOP" Click="Develop_Click"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Import" Click="Import_Click"/><Button Content="Export" Click="Export_Click"/></StackPanel></Grid></Border>
<Grid Grid.Row="1">
<Grid x:Name="LibraryView"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#1C1C1C" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0"><DockPanel Margin="14"><TextBlock DockPanel.Dock="Top" Text="CATALOG" FontSize="11" Foreground="{StaticResource Muted}" Margin="4,6,4,12"/><TreeView Background="Transparent" BorderThickness="0"><TreeViewItem Header="All Photos" IsExpanded="True"><TreeViewItem Header="Recently Added"/><TreeViewItem Header="Favorites"/><TreeViewItem Header="Rejected"/></TreeViewItem><TreeViewItem Header="Folders" IsExpanded="True"><TreeViewItem Header="RAW Library"/></TreeViewItem><TreeViewItem Header="Collections" IsExpanded="True"><TreeViewItem Header="Portfolio"/><TreeViewItem Header="Print Selects"/></TreeViewItem></TreeView></DockPanel></Border><Grid Grid.Column="1" Background="#151515"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="190"/></Grid.RowDefinitions><Border Margin="20" Background="#101010" BorderBrush="#303030" BorderThickness="1"><Grid><TextBlock x:Name="EmptyHint" Text="Import photos to begin&#x0a;&#x0a;CR3  •  ARW  •  RAF  •  DNG  •  TIFF  •  JPEG" TextAlignment="Center" VerticalAlignment="Center" Foreground="#777" FontSize="16"/><Image x:Name="Preview" Stretch="Uniform" Visibility="Collapsed"/></Grid></Border><Border Grid.Row="1" Background="#1B1B1B" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"><ScrollViewer HorizontalScrollBarVisibility="Auto"><WrapPanel x:Name="Filmstrip" Margin="14"/></ScrollViewer></Border></Grid><Border Grid.Column="2" Background="#1B1B1B" Padding="18"><StackPanel><TextBlock Text="LIBRARY" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="LibraryCount" Text="0 photos" FontSize="22" Margin="0,8,0,18"/><Button Content="Import Photos" Click="Import_Click" HorizontalAlignment="Left"/><TextBlock Text="Aetherlight Catalog" FontWeight="SemiBold" Margin="0,30,0,8"/><TextBlock Text="Non-destructive editing, RAW development and photo organization." TextWrapping="Wrap" Foreground="#999"/></StackPanel></Border></Grid>
<Grid x:Name="DevelopView" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#1C1C1C" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0"><StackPanel Margin="14"><TextBlock Text="TOOLS" FontSize="11" Foreground="{StaticResource Muted}" Margin="4,6,4,12"/><Button x:Name="CropButton" Content="Crop &amp; Straighten" Click="Crop_Click"/><Button x:Name="HealButton" Content="Heal" Click="Heal_Click"/><Button x:Name="MaskButton" Content="Masking" Click="Mask_Click"/><Button x:Name="PickerButton" Content="Color Picker" Click="Picker_Click"/><Separator Margin="0,15"/><TextBlock Text="Navigator" FontWeight="SemiBold"/><Border Height="150" Background="#111" Margin="0,10"><Image Source="{Binding ElementName=DevelopPreview,Path=Source}" Stretch="Uniform"/></Border><StackPanel x:Name="CropControls" Visibility="Collapsed"><TextBlock Text="STRAIGHTEN" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,12,0,3"/><Slider x:Name="CropAngleSlider" Minimum="-15" Maximum="15" Value="0"/><TextBlock x:Name="CropAngleValue" Text="0.0°" HorizontalAlignment="Right"/><Button Content="Apply Crop" Click="ApplyCrop_Click"/><Button Content="Cancel" Click="CancelTool_Click"/></StackPanel><StackPanel x:Name="MaskControls" Visibility="Collapsed"><TextBlock Text="BRUSH MASK" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,12,0,3"/><TextBlock Text="Size"/><Slider x:Name="MaskSizeSlider" Minimum="5" Maximum="150" Value="40"/><TextBlock Text="Mask Exposure" Margin="0,8,0,3"/><Slider x:Name="MaskExposureSlider" Minimum="-3" Maximum="3" Value="1"/><TextBlock x:Name="MaskExposureValue" Text="+1.00" HorizontalAlignment="Right"/><Button Content="Apply Mask" Click="ApplyMask_Click"/><Button Content="Clear Mask" Click="ClearMask_Click"/><Button Content="Exit Masking" Click="CancelTool_Click"/></StackPanel></StackPanel></Border>
<Grid Grid.Column="1" Background="#101010"><Border Margin="20" Background="#080808" BorderBrush="#303030" BorderThickness="1"><Grid><Image x:Name="DevelopPreview" Stretch="Uniform" CacheMode="BitmapCache" MouseLeftButtonDown="Preview_MouseDown" MouseMove="Preview_MouseMove" MouseLeftButtonUp="Preview_MouseUp"/><Canvas x:Name="OverlayCanvas" IsHitTestVisible="False"/><TextBlock x:Name="DevelopEmpty" Text="Select a photo in Library" Foreground="#666" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border></Grid>
<ScrollViewer Grid.Column="2" Background="#1B1B1B" VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="HISTOGRAM" FontSize="11" Foreground="{StaticResource Muted}"/><Border Height="150" Background="#101010" Margin="0,8,0,18"><Canvas x:Name="HistogramCanvas"/></Border><TextBlock Text="BASIC" FontSize="11" Foreground="{StaticResource Muted}"/>
<TextBlock Text="Exposure" Margin="0,14,0,3"/><Grid><Slider x:Name="ExposureSlider" Minimum="-5" Maximum="5" Value="0"/><TextBlock x:Name="ExposureValue" Text="0.00" HorizontalAlignment="Right" Width="54" TextAlignment="Right" IsHitTestVisible="False" Background="#1B1B1B" Padding="4,0,0,0"/></Grid>
<TextBlock Text="Contrast" Margin="0,10,0,3"/><Grid><Slider x:Name="ContrastSlider" Minimum="-100" Maximum="100" Value="0"/><TextBlock x:Name="ContrastValue" Text="0" HorizontalAlignment="Right" Width="54" TextAlignment="Right" IsHitTestVisible="False" Background="#1B1B1B" Padding="4,0,0,0"/></Grid>
<TextBlock Text="Highlights" Margin="0,10,0,3"/><Grid><Slider x:Name="HighlightsSlider" Minimum="-100" Maximum="100" Value="0"/><TextBlock x:Name="HighlightsValue" Text="0" HorizontalAlignment="Right" Width="54" TextAlignment="Right" IsHitTestVisible="False" Background="#1B1B1B" Padding="4,0,0,0"/></Grid>
<TextBlock Text="Shadows" Margin="0,10,0,3"/><Grid><Slider x:Name="ShadowsSlider" Minimum="-100" Maximum="100" Value="0"/><TextBlock x:Name="ShadowsValue" Text="0" HorizontalAlignment="Right" Width="54" TextAlignment="Right" IsHitTestVisible="False" Background="#1B1B1B" Padding="4,0,0,0"/></Grid>
<TextBlock Text="Whites" Margin="0,10,0,3"/><Grid><Slider x:Name="WhitesSlider" Minimum="-100" Maximum="100" Value="0"/><TextBlock x:Name="WhitesValue" Text="0" HorizontalAlignment="Right" Width="54" TextAlignment="Right" IsHitTestVisible="False" Background="#1B1B1B" Padding="4,0,0,0"/></Grid>
<TextBlock Text="Blacks" Margin="0,10,0,3"/><Grid><Slider x:Name="BlacksSlider" Minimum="-100" Maximum="100" Value="0"/><TextBlock x:Name="BlacksValue" Text="0" HorizontalAlignment="Right" Width="54" TextAlignment="Right" IsHitTestVisible="False" Background="#1B1B1B" Padding="4,0,0,0"/></Grid>
<Separator Margin="0,18"/><TextBlock Text="COLOR" FontSize="11" Foreground="{StaticResource Muted}"/>
<TextBlock Text="Temperature" Margin="0,14,0,3"/><Grid><Slider x:Name="TemperatureSlider" Minimum="-100" Maximum="100" Value="0"/><TextBlock x:Name="TemperatureValue" Text="0" HorizontalAlignment="Right" Width="54" TextAlignment="Right" IsHitTestVisible="False" Background="#1B1B1B" Padding="4,0,0,0"/></Grid>
<TextBlock Text="Tint" Margin="0,10,0,3"/><Grid><Slider x:Name="TintSlider" Minimum="-100" Maximum="100" Value="0"/><TextBlock x:Name="TintValue" Text="0" HorizontalAlignment="Right" Width="54" TextAlignment="Right" IsHitTestVisible="False" Background="#1B1B1B" Padding="4,0,0,0"/></Grid>
<TextBlock Text="Vibrance" Margin="0,10,0,3"/><Grid><Slider x:Name="VibranceSlider" Minimum="-100" Maximum="100" Value="0"/><TextBlock x:Name="VibranceValue" Text="0" HorizontalAlignment="Right" Width="54" TextAlignment="Right" IsHitTestVisible="False" Background="#1B1B1B" Padding="4,0,0,0"/></Grid>
<TextBlock Text="Saturation" Margin="0,10,0,3"/><Grid><Slider x:Name="SaturationSlider" Minimum="-100" Maximum="100" Value="0"/><TextBlock x:Name="SaturationValue" Text="0" HorizontalAlignment="Right" Width="54" TextAlignment="Right" IsHitTestVisible="False" Background="#1B1B1B" Padding="4,0,0,0"/></Grid>
<Separator Margin="0,18"/><TextBlock Text="TONE CURVE" FontSize="11" Foreground="{StaticResource Muted}"/><Border Height="120" Background="#101010" Margin="0,8"><Canvas><Line X1="0" Y1="115" X2="330" Y2="5" Stroke="#777"/><Polyline Points="0,115 70,95 145,60 235,25 330,5" Stroke="{StaticResource Accent}" StrokeThickness="2"/></Canvas></Border><Separator Margin="0,18"/><TextBlock Text="COLOR GRADING" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock Text="Shadows" Margin="0,12,0,3"/><Slider/><TextBlock Text="Midtones" Margin="0,10,0,3"/><Slider/><TextBlock Text="Highlights" Margin="0,10,0,3"/><Slider/><Separator Margin="0,18"/><TextBlock Text="MASKING" FontSize="11" Foreground="{StaticResource Muted}"/><Button Content="Select Subject • AI" Margin="0,10,0,0"/><Button Content="Select Sky • AI"/><Button Content="Brush Mask" Click="Mask_Click"/><Button Content="Linear Gradient"/><Button Content="Radial Gradient"/></StackPanel></ScrollViewer></Grid>
</Grid>
<StatusBar Grid.Row="2" Background="#111"><TextBlock x:Name="StatusText" Text="Aetherlight • Ready" Foreground="#888"/><TextBlock Text="Windows x64" HorizontalAlignment="Right" Margin="20,0" Foreground="#666"/></StatusBar>
</Grid></Window>