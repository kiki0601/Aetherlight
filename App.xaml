<Application x:Class="Aetherlight.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#181818"/>
    <SolidColorBrush x:Key="Panel" Color="#202020"/>
    <SolidColorBrush x:Key="Panel2" Color="#252525"/>
    <SolidColorBrush x:Key="Border" Color="#333333"/>
    <SolidColorBrush x:Key="Text" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="Muted" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="Accent" Color="#D9A441"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Panel2}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="2"/></Style>
  </Application.Resources>
</Application>