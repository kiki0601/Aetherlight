<Window x:Class="Aetherlight.ProfileBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profile Browser" Width="980" Height="700" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#151515" Foreground="#E8E8E8">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="PROFILE BROWSER" FontSize="16" FontWeight="Bold"/>
                <TextBlock x:Name="CameraText" Text="Camera" Foreground="#999" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Content="×" Width="34" Height="30" HorizontalAlignment="Right" Click="Close_Click"/>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,12">
            <Button x:Name="AllButton" Content="ALL" Click="All_Click"/>
            <Button x:Name="ColorButton" Content="COLOR" Click="Color_Click"/>
            <Button x:Name="BwButton" Content="B&amp;W" Click="Bw_Click"/>
        </StackPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="ProfileGrid"/>
        </ScrollViewer>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="HintText" Text="Choose a profile. Profiles are applied non-destructively and do not alter the Basic sliders." Foreground="#888" VerticalAlignment="Center"/>
            <Button Content="Close" Width="90" HorizontalAlignment="Right" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
