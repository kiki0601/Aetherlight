<Window x:Class="Aetherlight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aetherlight" Width="1500" Height="900" MinWidth="1100" MinHeight="700"
        Background="#111111" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="MainWindow_Loaded">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E7E7E7"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
        <Style TargetType="Button"><Setter Property="Foreground" Value="#E4E4E4"/><Setter Property="Background" Value="#242424"/><Setter Property="BorderBrush" Value="#3A3A3A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="2"/><Setter Property="FontSize" Value="11"/></Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="20,7"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#1D1D1D"/><Setter Property="BorderBrush" Value="#303030"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Padding" Value="8,8"/></Style>
        <Style x:Key="ValueBox" TargetType="TextBox"><Setter Property="Foreground" Value="#DADADA"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="2,0"/><Setter Property="FontSize" Value="11"/><Setter Property="Width" Value="68"/><Setter Property="HorizontalContentAlignment" Value="Right"/><Setter Property="ToolTip" Value="Click the value and type an exact number. Enter applies. Up/Down changes by one step."/></Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock"><Setter Property="Foreground" Value="#858585"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
        <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="7,4"/><Setter Property="Margin" Value="1"/><Setter Property="FontSize" Value="10"/></Style>
        <Style TargetType="Slider"><Setter Property="Margin" Value="0,2,0,9"/><Setter Property="Height" Value="18"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition/><RowDefinition Height="28"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#191919" BorderBrush="#303030" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0"><TextBlock Text="AETHERLIGHT" FontSize="15" FontWeight="Bold"/><TextBlock Text="  RAW EDITOR" Foreground="#666" FontSize="10" Margin="7,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button x:Name="LibraryTab" Content="LIBRARY" Style="{StaticResource NavButton}" Click="Library_Click"/><Button x:Name="DevelopTab" Content="DEVELOP" Style="{StaticResource NavButton}" Click="Develop_Click"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"><Button Content="Import" Click="Import_Click"/><Button x:Name="ExportButton" Content="Export" Click="Export_Click"/></StackPanel></Grid></Border>
        <Grid Grid.Row="1">
            <Grid x:Name="LibraryView"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#181818" BorderBrush="#303030" BorderThickness="0,0,1,0"><StackPanel Margin="14"><TextBlock Text="LIBRARY" Style="{StaticResource SectionHeader}"/><TextBlock Text="CATALOG" Foreground="#666" FontSize="10" Margin="3,8,3,7"/><TreeView Background="Transparent" BorderThickness="0"><TreeViewItem Header="All Photos" IsExpanded="True"><TreeViewItem Header="Recently Added"/><TreeViewItem Header="Favorites"/><TreeViewItem Header="Rejected"/></TreeViewItem><TreeViewItem Header="Folders" IsExpanded="True"><TreeViewItem Header="RAW Library"/></TreeViewItem><TreeViewItem Header="Collections" IsExpanded="True"><TreeViewItem Header="Portfolio"/><TreeViewItem Header="Print Selects"/></TreeViewItem></TreeView></StackPanel></Border><Grid Grid.Column="1" Background="#101010"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="132"/></Grid.RowDefinitions><Border Margin="18" Background="#090909" BorderBrush="#272727" BorderThickness="1"><Grid><TextBlock x:Name="EmptyHint" Text="Import photos to begin&#x0A;&#x0A;CR3  •  ARW  •  RAF  •  DNG  •  TIFF  •  JPEG" TextAlignment="Center" VerticalAlignment="Center" Foreground="#555" FontSize="15"/><Image x:Name="Preview" Stretch="Uniform" Visibility="Collapsed"/></Grid></Border><Border Grid.Row="1" Background="#181818" BorderBrush="#303030" BorderThickness="0,1,0,0"><ScrollViewer HorizontalScrollBarVisibility="Auto"><WrapPanel x:Name="Filmstrip" Margin="12"/></ScrollViewer></Border></Grid><Border Grid.Column="2" Background="#181818" Padding="18"><StackPanel><TextBlock Text="FOLDER" Foreground="#666" FontSize="10"/><TextBlock Text="All Photos" FontSize="19" Margin="0,5,0,4"/><TextBlock x:Name="LibraryCount" Text="0 photos" Foreground="#888"/><Button Content="Import Photos" Click="Import_Click" HorizontalAlignment="Left" Margin="0,22,0,0"/><Separator Margin="0,22"/><TextBlock Text="Aetherlight Catalog" FontWeight="SemiBold"/><TextBlock Text="Non-destructive RAW development and photo organization." TextWrapping="Wrap" Foreground="#777" Margin="0,8,0,0"/></StackPanel></Border></Grid>
            <Grid x:Name="DevelopView" Visibility="Collapsed" Background="#0F0F0F"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#191919" BorderBrush="#303030" BorderThickness="0,0,1,0"><StackPanel Margin="7,12"><TextBlock Text="TOOLS" Foreground="#777" FontSize="9" Margin="4,0,4,7"/><Button Content="CROP" Style="{StaticResource ToolButton}" Click="Crop_Click" ToolTip="Crop &amp; Straighten"/><Button Content="HEAL" Style="{StaticResource ToolButton}" Click="Heal_Click" ToolTip="Heal / Clone"/><Button Content="MASK" Style="{StaticResource ToolButton}" Click="Mask_Click" ToolTip="Masking"/><Button Content="PICK" Style="{StaticResource ToolButton}" Click="Picker_Click" ToolTip="Color Picker"/><Separator Margin="3,10"/><Button Content="B" Tag="Basic" Style="{StaticResource ToolButton}" Click="SectionNav_Click"/><Button Content="C" Tag="Curves" Style="{StaticResource ToolButton}" Click="SectionNav_Click"/><Button Content="M" Tag="Color" Style="{StaticResource ToolButton}" Click="SectionNav_Click"/><Button Content="D" Tag="Detail" Style="{StaticResource ToolButton}" Click="SectionNav_Click"/><Button Content="E" Tag="Effects" Style="{StaticResource ToolButton}" Click="SectionNav_Click"/></StackPanel></Border><Grid Grid.Column="1" Background="#0B0B0B"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="120"/></Grid.RowDefinitions><Border Margin="14" Background="#050505" BorderBrush="#292929" BorderThickness="1"><Grid><Image x:Name="DevelopPreview" Stretch="Uniform" CacheMode="BitmapCache" MouseLeftButtonDown="Preview_MouseDown" MouseMove="Preview_MouseMove" MouseLeftButtonUp="Preview_MouseUp"/><Canvas x:Name="OverlayCanvas" IsHitTestVisible="False"/><TextBlock x:Name="DevelopEmpty" Text="Select a photo in Library" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><Border Grid.Row="1" Background="#171717" BorderBrush="#303030" BorderThickness="0,1,0,0"><Grid Margin="10,7"><ScrollViewer HorizontalScrollBarVisibility="Auto"><WrapPanel x:Name="EditorFilmstrip"/></ScrollViewer><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,7,3"><TextBlock Text="FIT" Foreground="#888" FontSize="10" Margin="0,0,10,0"/><TextBlock Text="100%" Foreground="#AAA" FontSize="10"/></StackPanel></Grid></Border></Grid><ScrollViewer Grid.Column="2" Background="#1A1A1A" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="14,11,12,20"><Grid Margin="0,0,0,8"><TextBlock Text="ADJUSTMENTS" FontSize="14" FontWeight="SemiBold"/><Button Content="RESET" Click="ResetAdvanced_Click" HorizontalAlignment="Right" Style="{StaticResource MiniButton}"/></Grid><Border Height="130" Background="#111" BorderBrush="#292929" BorderThickness="1" Margin="0,0,0,8"><Canvas x:Name="HistogramCanvas" Margin="4,0"/></Border>
                    <Expander x:Name="BasicSection" Header="BASIC" IsExpanded="True" Foreground="#EEE" FontWeight="SemiBold"><StackPanel Margin="4,7,4,3"><Grid Margin="0,0,0,7"><TextBlock Text="Profile" Foreground="#999"/><Button x:Name="ProfileButton" Content="Camera Standard" Width="150" HorizontalAlignment="Right" Click="ProfileButton_Click"/></Grid><TextBlock x:Name="ProfileValue" Text="Camera Standard" Foreground="#666" FontSize="10" Margin="0,-2,0,8"/><Grid Margin="0,0,0,7"><TextBlock Text="Tone Mapper" Foreground="#999"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Basic" Style="{StaticResource MiniButton}"/><Button Content="AgX" Style="{StaticResource MiniButton}"/></StackPanel></Grid><Grid><TextBlock Text="Exposure"/><TextBox x:Name="ExposureValue" Text="0.00" Style="{StaticResource ValueBox}" Tag="Exposure" PreviewMouseLeftButtonDown="SliderNumber_MouseDown" KeyDown="SliderNumber_KeyDown" LostFocus="SliderNumber_LostFocus"/></Grid><Slider x:Name="ExposureSlider" Minimum="-5" Maximum="5" Value="0"/><Grid><TextBlock Text="Contrast"/><TextBox x:Name="ContrastValue" Text="0" Style="{StaticResource ValueBox}" Tag="Contrast" PreviewMouseLeftButtonDown="SliderNumber_MouseDown" KeyDown="SliderNumber_KeyDown" LostFocus="SliderNumber_LostFocus"/></Grid><Slider x:Name="ContrastSlider" Minimum="-100" Maximum="100" Value="0"/><Grid><TextBlock Text="Highlights"/><TextBox x:Name="HighlightsValue" Text="0" Style="{StaticResource ValueBox}" Tag="Highlights" PreviewMouseLeftButtonDown="SliderNumber_MouseDown" KeyDown="SliderNumber_KeyDown" LostFocus="SliderNumber_LostFocus"/></Grid><Slider x:Name="HighlightsSlider" Minimum="-100" Maximum="100" Value="0"/><Grid><TextBlock Text="Shadows"/><TextBox x:Name="ShadowsValue" Text="0" Style="{StaticResource ValueBox}" Tag="Shadows" PreviewMouseLeftButtonDown="SliderNumber_MouseDown" KeyDown="SliderNumber_KeyDown" LostFocus="SliderNumber_LostFocus"/></Grid><Slider x:Name="ShadowsSlider" Minimum="-100" Maximum="100" Value="0"/><Grid><TextBlock Text="Whites"/><TextBox x:Name="WhitesValue" Text="0" Style="{StaticResource ValueBox}" Tag="Whites" PreviewMouseLeftButtonDown="SliderNumber_MouseDown" KeyDown="SliderNumber_KeyDown" LostFocus="SliderNumber_LostFocus"/></Grid><Slider x:Name="WhitesSlider" Minimum="-100" Maximum="100" Value="0"/><Grid><TextBlock Text="Blacks"/><TextBox x:Name="BlacksValue" Text="0" Style="{StaticResource ValueBox}" Tag="Blacks" PreviewMouseLeftButtonDown="SliderNumber_MouseDown" KeyDown="SliderNumber_KeyDown" LostFocus="SliderNumber_LostFocus"/></Grid><Slider x:Name="BlacksSlider" Minimum="-100" Maximum="100" Value="0"/></StackPanel></Expander>
                    <Expander x:Name="CurvesSection" Header="CURVES" IsExpanded="True" Foreground="#EEE" FontWeight="SemiBold" Margin="0,5,0,0"><StackPanel Margin="4,7,4,5"><Grid Height="210" Background="#111"><Canvas x:Name="CurveCanvas" MouseLeftButtonDown="CurveMouseDown" MouseMove="CurveMouseMove" MouseLeftButtonUp="CurveMouseUp"/></Grid><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="L" Tag="L" Click="CurveChannel_Click" Style="{StaticResource MiniButton}"/><Button Content="R" Tag="R" Click="CurveChannel_Click" Style="{StaticResource MiniButton}"/><Button Content="G" Tag="G" Click="CurveChannel_Click" Style="{StaticResource MiniButton}"/><Button Content="B" Tag="B" Click="CurveChannel_Click" Style="{StaticResource MiniButton}"/><Button Content="Reset" Click="CurveReset_Click" Style="{StaticResource MiniButton}"/></StackPanel></StackPanel></Expander>
                    <Expander x:Name="ColorSection" Header="COLOR" IsExpanded="True" Foreground="#EEE" FontWeight="SemiBold" Margin="0,5,0,0"><StackPanel Margin="4,7,4,4"><TextBlock Text="WHITE BALANCE" Foreground="#888" FontSize="9"/><Grid><TextBlock Text="Temperature"/><TextBox x:Name="TemperatureValue" Text="6500 K" Style="{StaticResource ValueBox}" Width="76" Tag="Temperature" PreviewMouseLeftButtonDown="SliderNumber_MouseDown" KeyDown="SliderNumber_KeyDown" LostFocus="SliderNumber_LostFocus"/></Grid><Slider x:Name="TemperatureSlider" Minimum="2000" Maximum="50000" Value="6500"/><Grid><TextBlock Text="Tint"/><TextBox x:Name="TintValue" Text="0" Style="{StaticResource ValueBox}" Tag="Tint" PreviewMouseLeftButtonDown="SliderNumber_MouseDown" KeyDown="SliderNumber_KeyDown" LostFocus="SliderNumber_LostFocus"/></Grid><Slider x:Name="TintSlider" Minimum="-150" Maximum="150" Value="0"/><Grid><TextBlock Text="Vibrance"/><TextBox x:Name="VibranceValue" Text="0" Style="{StaticResource ValueBox}" Tag="Vibrance" PreviewMouseLeftButtonDown="SliderNumber_MouseDown" KeyDown="SliderNumber_KeyDown" LostFocus="SliderNumber_LostFocus"/></Grid><Slider x:Name="VibranceSlider" Minimum="-100" Maximum="100" Value="0"/><Grid><TextBlock Text="Saturation"/><TextBox x:Name="SaturationValue" Text="0" Style="{StaticResource ValueBox}" Tag="Saturation" PreviewMouseLeftButtonDown="SliderNumber_MouseDown" KeyDown="SliderNumber_KeyDown" LostFocus="SliderNumber_LostFocus"/></Grid><Slider x:Name="SaturationSlider" Minimum="-100" Maximum="100" Value="0"/></StackPanel></Expander>
                    <Expander x:Name="DetailSection" Header="DETAIL" Foreground="#EEE" FontWeight="SemiBold" Margin="0,5,0,0"><StackPanel Margin="4,7"><TextBlock Text="Sharpening"/><Slider x:Name="SharpeningSlider" Minimum="0" Maximum="100"/><TextBlock Text="Noise Reduction"/><Slider x:Name="NoiseReductionSlider" Minimum="0" Maximum="100"/><TextBlock Text="Clarity"/><Slider x:Name="ClaritySlider" Minimum="-100" Maximum="100"/><TextBlock Text="Texture"/><Slider x:Name="TextureSlider" Minimum="-100" Maximum="100"/></StackPanel></Expander>
                    <Expander x:Name="EffectsSection" Header="EFFECTS" Foreground="#EEE" FontWeight="SemiBold" Margin="0,5"><StackPanel Margin="4,7"><TextBlock Text="Dehaze"/><Slider x:Name="DehazeSlider" Minimum="-100" Maximum="100"/><TextBlock Text="Vignette"/><Slider x:Name="VignetteSlider" Minimum="-100" Maximum="100"/><TextBlock Text="Film Grain"/><Slider x:Name="GrainSlider" Minimum="0" Maximum="100"/><TextBlock Text="Glow"/><Slider x:Name="GlowSlider" Minimum="0" Maximum="100"/><TextBlock Text="Halation"/><Slider x:Name="HalationSlider" Minimum="0" Maximum="100"/></StackPanel></Expander>
                    <Expander x:Name="ColorGradingSection" Header="COLOR GRADING" Foreground="#EEE" FontWeight="SemiBold" Margin="0,5"><StackPanel Margin="4,7"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="Shadows" Tag="S" Click="GradeRange_Click" Style="{StaticResource MiniButton}"/><Button Content="Midtones" Tag="M" Click="GradeRange_Click" Style="{StaticResource MiniButton}"/><Button Content="Highlights" Tag="H" Click="GradeRange_Click" Style="{StaticResource MiniButton}"/></StackPanel><Grid Height="190"><Canvas x:Name="ColorWheelCanvas" MouseLeftButtonDown="ColorWheelDown" MouseMove="ColorWheelMove" MouseLeftButtonUp="ColorWheelUp"/></Grid><TextBlock Text="Blending"/><Slider x:Name="GradeBlendSlider" Minimum="0" Maximum="1" Value="1"/><TextBlock Text="Balance"/><Slider x:Name="GradeBalanceSlider" Minimum="-100" Maximum="100" Value="0"/></StackPanel></Expander>
                    <Expander x:Name="MaskingSection" Header="MASKING" Foreground="#EEE" FontWeight="SemiBold" Margin="0,5"><StackPanel Margin="4,7"><WrapPanel><Button Content="Brush" Click="MaskBrush_Click" Style="{StaticResource MiniButton}"/><Button Content="Linear" Click="MaskLinear_Click" Style="{StaticResource MiniButton}"/><Button Content="Radial" Click="MaskRadial_Click" Style="{StaticResource MiniButton}"/><Button Content="Auto Sky" Click="MaskSky_Click" Style="{StaticResource MiniButton}"/><Button Content="Auto Subject" Click="MaskSubject_Click" Style="{StaticResource MiniButton}"/></WrapPanel><TextBlock Text="Mask Size"/><Slider x:Name="MaskSizeSlider" Minimum="5" Maximum="150" Value="40"/><TextBlock Text="Mask Exposure"/><Slider x:Name="MaskExposureSlider" Minimum="-3" Maximum="3" Value="1" ValueChanged="MaskExposure_ValueChanged"/><TextBlock x:Name="MaskExposureValue" Text="+1.00" Foreground="#888"/><Button Content="Apply Mask" Click="ApplyMask_Click" Style="{StaticResource MiniButton}" HorizontalAlignment="Left"/><Button Content="Clear Masks" Click="ClearMask_Click" Style="{StaticResource MiniButton}" HorizontalAlignment="Left"/></StackPanel></Expander>
                    <StackPanel x:Name="LegacyToolControls" Visibility="Collapsed"><StackPanel x:Name="CropControls" Visibility="Collapsed"><TextBlock Text="STRAIGHTEN"/><Slider x:Name="CropAngleSlider" Minimum="-15" Maximum="15" Value="0" ValueChanged="CropAngle_ValueChanged"/><TextBlock x:Name="CropAngleValue" Text="0.0°"/><Button Content="Apply Crop" Click="ApplyCrop_Click"/><Button Content="Cancel" Click="CancelTool_Click"/></StackPanel><StackPanel x:Name="MaskControls" Visibility="Collapsed"><TextBlock Text="BRUSH MASK"/><Slider x:Name="LegacyMaskSizeSlider" Minimum="5" Maximum="150" Value="40"/><TextBlock Text="Mask Exposure"/><Slider x:Name="LegacyMaskExposureSlider" Minimum="-3" Maximum="3" Value="1"/><Button Content="Apply Mask" Click="ApplyMask_Click"/><Button Content="Clear Mask" Click="ClearMask_Click"/><Button Content="Exit Masking" Click="CancelTool_Click"/></StackPanel></StackPanel>
                </StackPanel></ScrollViewer></Grid>
        </Grid>
        <StatusBar Grid.Row="2" Background="#0B0B0B"><TextBlock x:Name="StatusText" Text="Aetherlight • Ready" Foreground="#777"/><TextBlock Text="Windows x64" HorizontalAlignment="Right" Margin="20,0" Foreground="#444"/></StatusBar>
    </Grid>
</Window>
