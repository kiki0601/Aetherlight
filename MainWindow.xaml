<Window x:Class="Aetherlight.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Aetherlight" Width="1500" Height="900" MinWidth="1100" MinHeight="700" Background="{StaticResource Bg}">
<Grid>
<Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="#111111" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"><Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions><TextBlock Text="AETHERLIGHT" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="LIBRARY" Click="Library_Click"/><Button Content="DEVELOP" Click="Develop_Click"/><Button Content="MAP"/><Button Content="PRINT"/><Button Content="WEB"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Import" Click="Import_Click"/><Button Content="Export" Click="Export_Click"/></StackPanel></Grid></Border>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="#1C1C1C" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0"><DockPanel Margin="14"><TextBlock DockPanel.Dock="Top" Text="CATALOG" FontSize="11" Foreground="{StaticResource Muted}" Margin="4,6,4,12"/><TreeView Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"><TreeViewItem Header="All Photos" IsExpanded="True"><TreeViewItem Header="Recently Added"/><TreeViewItem Header="Favorites"/><TreeViewItem Header="Rejected"/></TreeViewItem><TreeViewItem Header="Folders" IsExpanded="True"><TreeViewItem Header="RAW Library"/></TreeViewItem><TreeViewItem Header="Collections" IsExpanded="True"><TreeViewItem Header="Portfolio"/><TreeViewItem Header="Print Selects"/></TreeViewItem></TreeView></DockPanel></Border>
<Grid Grid.Column="1" Background="#151515"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="210"/></Grid.RowDefinitions><Border Margin="20" Background="#101010" BorderBrush="#303030" BorderThickness="1"><Grid><TextBlock x:Name="EmptyHint" Text="Drop RAW photos here\n\nCR3  •  ARW  •  RAF  •  DNG  •  TIFF  •  JPEG" TextAlignment="Center" VerticalAlignment="Center" Foreground="#777" FontSize="16"/><Image x:Name="Preview" Stretch="Uniform" Visibility="Collapsed"/></Grid></Border><Border Grid.Row="1" Background="#1B1B1B" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"><ScrollViewer HorizontalScrollBarVisibility="Auto"><WrapPanel x:Name="Filmstrip" Margin="14"/></ScrollViewer></Border></Grid>
<ScrollViewer Grid.Column="2" Background="#1B1B1B" VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="DEVELOP" FontSize="11" Foreground="{StaticResource Muted}" Margin="2,6,2,14"/><TextBlock Text="Basic" FontWeight="SemiBold"/><TextBlock Text="Exposure" Margin="0,18,0,4"/><Slider x:Name="Exposure" Minimum="-5" Maximum="5" Value="0"/><TextBlock Text="Contrast" Margin="0,10,0,4"/><Slider Minimum="-100" Maximum="100" Value="0"/><TextBlock Text="Highlights" Margin="0,10,0,4"/><Slider Minimum="-100" Maximum="100" Value="0"/><TextBlock Text="Shadows" Margin="0,10,0,4"/><Slider Minimum="-100" Maximum="100" Value="0"/><TextBlock Text="Whites" Margin="0,10,0,4"/><Slider Minimum="-100" Maximum="100" Value="0"/><TextBlock Text="Blacks" Margin="0,10,0,4"/><Slider Minimum="-100" Maximum="100" Value="0"/><Separator Margin="0,18"/><TextBlock Text="Color" FontWeight="SemiBold"/><TextBlock Text="Temp" Margin="0,14,0,4"/><Slider Minimum="2000" Maximum="50000" Value="6500"/><TextBlock Text="Tint" Margin="0,10,0,4"/><Slider Minimum="-100" Maximum="100" Value="0"/><TextBlock Text="Vibrance" Margin="0,10,0,4"/><Slider Minimum="-100" Maximum="100" Value="0"/><TextBlock Text="Saturation" Margin="0,10,0,4"/><Slider Minimum="-100" Maximum="100" Value="0"/><Separator Margin="0,18"/><TextBlock Text="Tone Curve" FontWeight="SemiBold"/><Border Height="130" Background="#111" Margin="0,10"><Polyline Points="0,120 30,100 65,65 95,35 125,10" Stroke="#D9A441" StrokeThickness="2"/></Border><Separator Margin="0,18"/><TextBlock Text="Color Grading" FontWeight="SemiBold"/><TextBlock Text="Shadows" Margin="0,14,0,4"/><Slider/><TextBlock Text="Midtones" Margin="0,10,0,4"/><Slider/><TextBlock Text="Highlights" Margin="0,10,0,4"/><Slider/><Separator Margin="0,18"/><TextBlock Text="Detail" FontWeight="SemiBold"/><TextBlock Text="Sharpening" Margin="0,14,0,4"/><Slider/><TextBlock Text="Noise Reduction" Margin="0,10,0,4"/><Slider/><Separator Margin="0,18"/><TextBlock Text="Optics" FontWeight="SemiBold"/><CheckBox Content="Remove Chromatic Aberration" Margin="0,12,0,0"/><CheckBox Content="Enable Lens Corrections" Margin="0,8,0,0"/><Separator Margin="0,18"/><TextBlock Text="Masking" FontWeight="SemiBold"/><Button Content="Select Subject • AI" Margin="0,12,0,0"/><Button Content="Select Sky • AI"/><Button Content="Brush Mask"/><Button Content="Linear Gradient"/><Button Content="Radial Gradient"/></StackPanel></ScrollViewer></Grid>
<StatusBar Grid.Row="2" Background="#111"><TextBlock Text="Aetherlight • RAW Development Engine" Foreground="#888"/><TextBlock Text="Ready" HorizontalAlignment="Right" Margin="20,0" Foreground="#888"/></StatusBar>
</Grid></Window>